type Health = enum { SrcOk, SrcSuspect, SrcFault };

contract BaroMonitor_contract(baro_valid: bool; selftest: bool) returns (health: Health; usable: bool);
let
  guarantee "SRC_5_usable" usable = (baro_valid and selftest);
  guarantee "SRC_5_fault" health = SrcFault => not baro_valid;
  guarantee "SRC_5_ok" usable => health = SrcOk;
tel

function BaroMonitor(baro_valid: bool; selftest: bool) returns (health: Health; usable: bool);
(*@contract import BaroMonitor_contract(baro_valid, selftest) returns (health, usable); *)
let
  --%MAIN;
  usable = baro_valid and selftest;
  health = if not baro_valid then SrcFault else if usable then SrcOk else SrcSuspect;
tel

