-- note: integers are proved as mathematical integers, and 0 runtime-error check(s) prove that every integer value stays within its C type as `GnssMonitor` runs (no overflow, no division by zero, indexes in bounds; integer division and casts follow C; `GnssMonitor`'s integer inputs are assumed within their types)

-- package: user (types)
type FixType = enum { NoFix, Fix2D, Fix3D };
type Health = enum { SrcOk, SrcSuspect, SrcFault };

-- package: user (constants)
const SATS_MIN : int = 4;
const HDOP_MAX : int = 250;

contract GnssMonitor_contract(gnss_valid: bool; fix: FixType; sats: int; hdop: int) returns (health: Health; usable: bool);
let
  guarantee "SRC_1_usable" usable = (gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX);
  guarantee "SRC_2_fault" health = SrcFault => not gnss_valid or fix = NoFix;
  guarantee "SRC_2_ok" usable => health = SrcOk;
  guarantee "SRC_2_suspect" health = SrcSuspect => gnss_valid and fix <> NoFix and not usable;
tel

function GnssMonitor(gnss_valid: bool; fix: FixType; sats: int; hdop: int) returns (health: Health; usable: bool);
(*@contract import GnssMonitor_contract(gnss_valid, fix, sats, hdop) returns (health, usable); *)
let
  --%MAIN;
  usable = gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX;
  health = if not gnss_valid or fix = NoFix then SrcFault else if usable then SrcOk else SrcSuspect;
  assert - 2147483648 <= sats and sats <= 2147483647;
  assert - 2147483648 <= hdop and hdop <= 2147483647;
tel

