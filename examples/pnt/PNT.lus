function BoundedF(x: real; lo: real; hi: real) returns (y: real);
(*@contract import BoundedF_contract(x, lo, hi) returns (y); *)
let
  y = if x < lo then lo else if x > hi then hi else x;
tel

function GnssMonitor(gnss_valid: bool; fix: FixType; sats: int; hdop: int) returns (health: Health; usable: bool);
(*@contract import GnssMonitor_contract(gnss_valid, fix, sats, hdop) returns (health, usable); *)
let
  usable = gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX;
  health = if not gnss_valid or fix = NoFix then SrcFault else if usable then SrcOk else SrcSuspect;
tel

function ImuMonitor(imu_valid: bool; selftest: bool; dvx: real; dvy: real; dvz: real) returns (health: Health; usable: bool; svx: real; svy: real; svz: real);
(*@contract import ImuMonitor_contract(imu_valid, selftest, dvx, dvy, dvz) returns (health, usable, svx, svy, svz); *)
let
  usable = imu_valid and selftest;
  health = if not imu_valid then SrcFault else if usable then SrcOk else SrcSuspect;
  svx = BoundedF(dvx, - VEL_STEP_MAX_M, VEL_STEP_MAX_M);
  svy = BoundedF(dvy, - VEL_STEP_MAX_M, VEL_STEP_MAX_M);
  svz = BoundedF(dvz, - VEL_STEP_MAX_M, VEL_STEP_MAX_M);
tel

function BaroMonitor(baro_valid: bool; selftest: bool) returns (health: Health; usable: bool);
(*@contract import BaroMonitor_contract(baro_valid, selftest) returns (health, usable); *)
let
  usable = baro_valid and selftest;
  health = if not baro_valid then SrcFault else if usable then SrcOk else SrcSuspect;
tel

node KalmanChan(freeze: bool; bootstrap: bool; meas_ok: bool; z: real; step: real; q: real; r: real) returns (pos: real; p: real; k: real);
(*@contract import KalmanChan_contract(freeze, bootstrap, meas_ok, z, step, q, r) returns (pos, p, k); *)
var pr: real; pp: real; qc: real; rc: real; __rtc0: real; __rtc1: real;
let
  qc = BoundedF(q, 0.0, P_CEIL);
  rc = BoundedF(r, R_MIN, P_CEIL);
  pr = if freeze then 0.0 -> pre pos else (0.0 -> pre pos) + step;
  pp = if freeze then 0.0 -> pre p else if bootstrap then P_CEIL else __rtc0;
  k = pp / (pp + rc);
  pos = if freeze then pr else __rtc1;
  p = if freeze then pp else if meas_ok then (1.0 - k) * pp else pp;
  __rtc0 = BoundedF((P_CEIL -> pre p) + qc, P_FLOOR, P_CEIL);
  __rtc1 = BoundedF(if meas_ok then pr + k * (z - pr) else pr, - POS_SAT_M, POS_SAT_M);
tel

node ClockDiscipline(sync_en: bool; gnss_tow_s: int) returns (tow: int; synced: bool; holdover_s: int; __rte0: bool; __rte1: bool; __rte2: bool);
(*@contract import ClockDiscipline_contract(sync_en, gnss_tow_s) returns (tow, synced, holdover_s); *)
var phase10: int;
let
  synced = sync_en;
  phase10 = 0 -> (if synced or pre phase10 >= 9 then 0 else pre phase10 + 1);
  tow = if synced then gnss_tow_s else 0 -> (if pre phase10 >= 9 and pre tow < TOW_MAX_S then pre tow + 1 else pre tow);
  holdover_s = if synced then 0 else 0 -> (if pre phase10 >= 9 and pre holdover_s < HOLDOVER_MAX_S then pre holdover_s + 1 else pre holdover_s);
  __rte0 = not (true -> false) => (not (synced or pre phase10 >= 9) => - 2147483648 <= pre phase10 + 1 and pre phase10 + 1 <= 2147483647);
  __rte1 = not synced => (not (true -> false) => (pre phase10 >= 9 and pre tow < TOW_MAX_S => - 2147483648 <= pre tow + 1 and pre tow + 1 <= 2147483647));
  __rte2 = not synced => (not (true -> false) => (pre phase10 >= 9 and pre holdover_s < HOLDOVER_MAX_S => - 2147483648 <= pre holdover_s + 1 and pre holdover_s + 1 <= 2147483647));
tel

node PNT(gnss_valid: bool; fix: FixType; sats: int; hdop: int; gnss_x: real; gnss_y: real; gnss_z: real; gnss_time_valid: bool; gnss_tow_s: int; imu_valid: bool; imu_selftest: bool; dvx: real; dvy: real; dvz: real; baro_valid: bool; baro_selftest: bool; baro_alt: real) returns (sol_x: real; sol_y: real; sol_alt: real; sol_vx: real; sol_vy: real; sol_va: real; sol_tow: int; sol_status: PvtStatus; time_synced: bool; holdover_s: int; coast_cyc: int; protection_m: real; integrity_ok: bool; alert: Alert; gnss_usable: bool; imu_usable: bool; baro_usable: bool; innov_ok: bool; v_agree: bool; anchored: bool; kx: real; ky: real; ka: real; p_x: real; p_y: real; p_a: real; svx: real; svy: real; svz: real; gnss_health: Health; imu_health: Health; baro_health: Health);
(*@contract import PNT_contract(gnss_valid, fix, sats, hdop, gnss_x, gnss_y, gnss_z, gnss_time_valid, gnss_tow_s, imu_valid, imu_selftest, dvx, dvy, dvz, baro_valid, baro_selftest, baro_alt) returns (sol_x, sol_y, sol_alt, sol_vx, sol_vy, sol_va, sol_tow, sol_status, time_synced, holdover_s, coast_cyc, protection_m, integrity_ok, alert, gnss_usable, imu_usable, baro_usable, innov_ok, v_agree, anchored, kx, ky, ka, p_x, p_y, p_a, svx, svy, svz, gnss_health, imu_health, baro_health); *)
var gh: Health; ih: Health; bh: Health; pred_x: real; pred_y: real; trusted: bool; meas_ok: bool; v_gate: bool; v_accept: bool; v_meas_ok: bool; v_z: real; v_r: real; tow: int; synced: bool; hol: int; conv_cyc: int; converged: bool; cnt: int; coast_timed_out: bool; nav: PvtStatus; hold: bool; fix_ok: bool; nav_ok: bool; imu_ok: bool; __sm_state: Navigator_StateEnum; __sm_next_state: Navigator_StateEnum; __act_Alert_b1: bool; __act_Alert_n1: bool; __act_Alert_b2: bool; __act_Alert_n2: bool; __act_Alert_b3: bool; __act_Alert_n3: bool; __act_Alert_b4: bool; __act_Alert_g2: bool; __act_Alert_g3: bool; __act_Alert_g4: bool; __act_Alert_x1_alert: Alert; __act_Alert_x2_alert: Alert; __act_Alert_x3_alert: Alert; __act_Alert_x4_alert: Alert; __act_Alert_xe_alert: Alert; __ck3: bool; __ck0: bool; __ck4: bool; __ck1: bool; __ck5: bool; __ck2: bool; __ck6: bool; __ck7: bool; __rte0: bool; __rte1: bool; __rtp0: bool; __rtp1: bool; __rtp2: bool;
let
  --%MAIN;
  __ck3 = __act_Alert_b1;
  __ck0 = not __act_Alert_b1;
  __ck4 = __ck0 and __act_Alert_g2;
  __ck1 = __ck0 and not __act_Alert_g2;
  __ck5 = __ck1 and __act_Alert_g3;
  __ck2 = __ck1 and not __act_Alert_g3;
  __ck6 = __ck2 and __act_Alert_g4;
  __ck7 = __ck2 and not __act_Alert_g4;
  (gh, gnss_usable) = GnssMonitor(gnss_valid, fix, sats, hdop);
  (ih, imu_usable, svx, svy, svz) = ImuMonitor(imu_valid, imu_selftest, dvx, dvy, dvz);
  (bh, baro_usable) = BaroMonitor(baro_valid, baro_selftest);
  gnss_health = gh;
  imu_health = ih;
  baro_health = bh;
  pred_x = 0.0 -> pre sol_x;
  pred_y = 0.0 -> pre sol_y;
  innov_ok = gnss_x - pred_x <= POS_DISAGREE_M and pred_x - gnss_x <= POS_DISAGREE_M and gnss_y - pred_y <= POS_DISAGREE_M and pred_y - gnss_y <= POS_DISAGREE_M;
  v_gate = not baro_usable or gnss_z - baro_alt <= V_DISAGREE_M and baro_alt - gnss_z <= V_DISAGREE_M;
  v_agree = v_gate;
  trusted = sol_status = PvtFused or sol_status = PvtCoasting;
  meas_ok = gnss_usable and gnss_time_valid and (innov_ok or not trusted);
  v_accept = gnss_usable and gnss_time_valid and (v_gate or not trusted);
  anchored = meas_ok and not hold;
  v_z = if v_accept then gnss_z else baro_alt;
  v_r = if v_accept then R_GNSS_Z else R_BARO;
  v_meas_ok = v_accept or baro_usable;
  (sol_x, p_x, kx) = KalmanChan(hold, not trusted, meas_ok, gnss_x, svx, Q_POS, R_GNSS);
  (sol_y, p_y, ky) = KalmanChan(hold, not trusted, meas_ok, gnss_y, svy, Q_POS, R_GNSS);
  (sol_alt, p_a, ka) = KalmanChan(hold, not trusted, v_meas_ok, v_z, svz, Q_ALT, v_r);
  sol_vx = if hold then 0.0 -> pre sol_vx else svx * 10.0;
  sol_vy = if hold then 0.0 -> pre sol_vy else svy * 10.0;
  sol_va = if hold then 0.0 -> pre sol_va else svz * 10.0;
  (tow, synced, hol, __rtp0, __rtp1, __rtp2) = ClockDiscipline(gnss_usable and gnss_time_valid, gnss_tow_s);
  sol_tow = tow;
  time_synced = synced;
  holdover_s = hol;
  conv_cyc = 0 -> (if sol_status = PvtAcquiring and meas_ok then pre conv_cyc + 1 else 0);
  converged = conv_cyc >= CONVERGE_CYCLES - 1;
  cnt = 0 -> (if nav <> pre nav then 0 else if pre cnt < DRIFT_WINDOW_CYCLES then pre cnt + 1 else pre cnt);
  coast_cyc = if sol_status = PvtCoasting then cnt else 0;
  coast_timed_out = sol_status = PvtCoasting and cnt >= COAST_BUDGET_CYCLES;
  sol_status = nav;
  fix_ok = gnss_usable and gnss_time_valid;
  nav_ok = meas_ok;
  imu_ok = imu_usable;
  protection_m = if sol_status = PvtFused then PROTECT_FUSED_M else if sol_status = PvtCoasting then PROTECT_COAST_M else 0.0;
  integrity_ok = alert <> AlertIntegrity;
  __sm_state = MInit -> pre __sm_next_state;
  __sm_next_state = if __sm_state = MInit then if fix_ok and imu_ok then MConverging else __sm_state else if __sm_state = MConverging then if not fix_ok or not imu_ok then MInit else if converged then MFused else __sm_state else if __sm_state = MFused then if not imu_ok then MHold else if not nav_ok then MCoasting else __sm_state else if __sm_state = MCoasting then if not imu_ok then MHold else if nav_ok then MFused else if coast_timed_out then MHold else __sm_state else if fix_ok and imu_ok then MConverging else __sm_state;
  nav = if __sm_state = MInit then PvtInvalid else if __sm_state = MConverging then PvtAcquiring else if __sm_state = MFused then PvtFused else if __sm_state = MCoasting then PvtCoasting else PvtHold;
  hold = if __sm_state = MInit then false else if __sm_state = MConverging then false else if __sm_state = MFused then false else if __sm_state = MCoasting then false else true;
  __act_Alert_b1 = not imu_usable;
  __act_Alert_n1 = not not imu_usable;
  __act_Alert_b2 = __act_Alert_n1 and coast_timed_out;
  __act_Alert_n2 = __act_Alert_n1 and not coast_timed_out;
  __act_Alert_b3 = __act_Alert_n2 and (fix_ok and baro_usable and (gnss_z - baro_alt > V_DISAGREE_M or baro_alt - gnss_z > V_DISAGREE_M));
  __act_Alert_n3 = __act_Alert_n2 and not (fix_ok and baro_usable and (gnss_z - baro_alt > V_DISAGREE_M or baro_alt - gnss_z > V_DISAGREE_M));
  __act_Alert_b4 = __act_Alert_n3 and (gnss_usable and not innov_ok);
  __act_Alert_g2 = if __ck0 then __act_Alert_b2 else false -> pre __act_Alert_g2;
  __act_Alert_g3 = if __ck1 then __act_Alert_b3 else false -> pre __act_Alert_g3;
  __act_Alert_g4 = if __ck2 then __act_Alert_b4 else false -> pre __act_Alert_g4;
  __act_Alert_x1_alert = if __ck3 then AlertSensor else AlertNone -> pre __act_Alert_x1_alert;
  __act_Alert_x2_alert = if __ck4 then AlertTimeout else AlertNone -> pre __act_Alert_x2_alert;
  __act_Alert_x3_alert = if __ck5 then AlertIntegrity else AlertNone -> pre __act_Alert_x3_alert;
  __act_Alert_x4_alert = if __ck6 then AlertIntegrity else AlertNone -> pre __act_Alert_x4_alert;
  __act_Alert_xe_alert = if __ck7 then AlertNone else AlertNone -> pre __act_Alert_xe_alert;
  alert = if __act_Alert_b1 then __act_Alert_x1_alert else if __act_Alert_g2 then __act_Alert_x2_alert else if __act_Alert_g3 then __act_Alert_x3_alert else if __act_Alert_g4 then __act_Alert_x4_alert else __act_Alert_xe_alert;
  __rte0 = not (true -> false) => (sol_status = PvtAcquiring and meas_ok => - 2147483648 <= pre conv_cyc + 1 and pre conv_cyc + 1 <= 2147483647);
  __rte1 = not (true -> false) => (not (nav <> pre nav) => (pre cnt < DRIFT_WINDOW_CYCLES => - 2147483648 <= pre cnt + 1 and pre cnt + 1 <= 2147483647));
  --%PROPERTY "rte1" __rte0;
  --%PROPERTY "rte2" __rte1;
  --%PROPERTY "rte3" __rtp0;
  --%PROPERTY "rte4" __rtp1;
  --%PROPERTY "rte5" __rtp2;
  assert - 2147483648 <= sats and sats <= 2147483647;
  assert - 2147483648 <= hdop and hdop <= 2147483647;
  assert - 2147483648 <= gnss_tow_s and gnss_tow_s <= 2147483647;
tel

