  guarantee "PVT_2_coast_step" sol_status = PvtCoasting and not anchored => (sol_x - pred_xg = svx or sol_x = POS_SAT_M or sol_x = - POS_SAT_M) and (sol_y - pred_yg = svy or sol_y = POS_SAT_M or sol_y = - POS_SAT_M);
  guarantee "PVT_3_budget" sol_status = PvtCoasting => coast_cyc <= COAST_BUDGET_CYCLES;
  guarantee "PVT_4_hold_frozen" sol_status = PvtHold => sol_x = pred_xg and sol_y = pred_yg and sol_alt = pred_ag and sol_vx = vxp and sol_vy = vyp and sol_va = vap;
  guarantee "PVT_5_fused_anchored" sol_status = PvtFused => (false -> pre anchored);
  guarantee "ALT_1_baro_track" sol_status <> PvtHold and not (gnss_usable and gnss_time_valid) and baro_usable => (baro_alt <= prag => sol_alt >= baro_alt and sol_alt <= prag) and (baro_alt >= prag => sol_alt <= baro_alt and sol_alt >= prag);
  guarantee "ALT_2_vstep" sol_status <> PvtHold and not (gnss_usable and gnss_time_valid) and not baro_usable => sol_alt - pred_ag <= VEL_STEP_MAX_M and pred_ag - sol_alt <= VEL_STEP_MAX_M;
  guarantee "NAV_2_root_step" not anchored and sol_status <> PvtHold => sol_x - pred_xg <= VEL_STEP_MAX_M and pred_xg - sol_x <= VEL_STEP_MAX_M and sol_y - pred_yg <= VEL_STEP_MAX_M and pred_yg - sol_y <= VEL_STEP_MAX_M;
  guarantee "KAL_root_gains" kx >= 0.0 and kx <= 1.0 and ky >= 0.0 and ky <= 1.0 and ka >= 0.0 and ka <= 1.0;
  guarantee "KAL_root_variances" p_x >= 0.0 and p_x <= P_CEIL and p_y >= 0.0 and p_y <= P_CEIL and p_a >= 0.0 and p_a <= P_CEIL;
  guarantee "INT_2_meaning" integrity_ok = (alert <> AlertIntegrity);
  guarantee "INT_3_vgate_def" v_agree = (not baro_usable or gnss_z - baro_alt <= V_DISAGREE_M and baro_alt - gnss_z <= V_DISAGREE_M);
  guarantee "AL_1_sensor" alert = AlertSensor => not imu_usable;
  guarantee "AL_2_timeout" alert = AlertTimeout => coast_cyc >= COAST_BUDGET_CYCLES;
  guarantee "AL_3_divergence" alert = AlertIntegrity => gnss_usable and gnss_time_valid and baro_usable and not v_agree or gnss_usable and not innov_ok;
  guarantee "AL_4_none" alert = AlertNone => imu_usable and coast_cyc < COAST_BUDGET_CYCLES and (not gnss_usable or innov_ok) and (not (gnss_usable and gnss_time_valid) or not baro_usable or v_agree);
  guarantee "TME_1_root" time_synced => sol_tow = gnss_tow_s;
  guarantee "TME_2_root" holdover_s <= HOLDOVER_MAX_S;
  guarantee "TME_3_root" sol_tow >= 0 and sol_tow <= TOW_MAX_S;
  guarantee "SOL_range" sol_x >= - POS_SAT_M and sol_x <= POS_SAT_M and sol_y >= - POS_SAT_M and sol_y <= POS_SAT_M and sol_alt >= - POS_SAT_M and sol_alt <= POS_SAT_M;
  mode SourcesHealthy (
    require gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX and gnss_time_valid;
