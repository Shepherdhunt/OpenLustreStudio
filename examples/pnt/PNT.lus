-- package: user (types)
type FixType = enum { NoFix, Fix2D, Fix3D };
type Health = enum { SrcOk, SrcSuspect, SrcFault };
type PvtStatus = enum { PvtInvalid, PvtAcquiring, PvtFused, PvtCoasting, PvtHold };
type Alert = enum { AlertNone, AlertSensor, AlertTimeout, AlertIntegrity };
type Navigator_StateEnum = enum { MInit, MConverging, MFused, MCoasting, MHold };

-- package: user (constants)
const SATS_MIN : int = 4;
const HDOP_MAX : int = 250;
const VEL_STEP_MAX_M : real = 2.0;
const POS_DISAGREE_M : real = 10.0;
const V_DISAGREE_M : real = 15.0;
const POS_MAX_M : real = 10000.0;
const POS_SAT_M : real = 12000.0;
const PROTECT_FUSED_M : real = 10.0;
const PROTECT_COAST_M : real = 120.0;
const Q_POS : real = 0.05;
const R_GNSS : real = 4.0;
const Q_ALT : real = 0.02;
const R_GNSS_Z : real = 9.0;
const R_BARO : real = 25.0;
const P_FLOOR : real = 0.25;
const P_CEIL : real = 100.0;
const R_MIN : real = 1.0;
const CONVERGE_CYCLES : int = 20;
const COAST_BUDGET_CYCLES : int = 50;
const DRIFT_WINDOW_CYCLES : int = 60;
const HOLDOVER_MAX_S : int = 10;
const TOW_MAX_S : int = 604800;

contract BoundedF_contract(x: real; lo: real; hi: real) returns (y: real);
let
  guarantee "SRC_6_range" y >= lo and y <= hi;
  guarantee "SRC_6_identity" x >= lo and x <= hi => y = x;
tel

contract GnssMonitor_contract(gnss_valid: bool; fix: FixType; sats: int; hdop: int) returns (health: Health; usable: bool);
let
  guarantee "SRC_1_usable" usable = (gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX);
  guarantee "SRC_2_fault" health = SrcFault => not gnss_valid or fix = NoFix;
  guarantee "SRC_2_ok" usable => health = SrcOk;
  guarantee "SRC_2_suspect" health = SrcSuspect => gnss_valid and fix <> NoFix and not usable;
tel

contract ImuMonitor_contract(imu_valid: bool; selftest: bool; dvx: real; dvy: real; dvz: real) returns (health: Health; usable: bool; svx: real; svy: real; svz: real);
let
  guarantee "SRC_3_clamp_x" svx >= - VEL_STEP_MAX_M and svx <= VEL_STEP_MAX_M and (dvx >= - VEL_STEP_MAX_M and dvx <= VEL_STEP_MAX_M => svx = dvx);
  guarantee "SRC_3_clamp_y" svy >= - VEL_STEP_MAX_M and svy <= VEL_STEP_MAX_M and (dvy >= - VEL_STEP_MAX_M and dvy <= VEL_STEP_MAX_M => svy = dvy);
  guarantee "SRC_3_clamp_z" svz >= - VEL_STEP_MAX_M and svz <= VEL_STEP_MAX_M and (dvz >= - VEL_STEP_MAX_M and dvz <= VEL_STEP_MAX_M => svz = dvz);
  guarantee "SRC_2b_usable" usable = (imu_valid and selftest);
  guarantee "SRC_2b_fault" health = SrcFault => not imu_valid;
  guarantee "SRC_2b_ok" usable => health = SrcOk;
tel

contract BaroMonitor_contract(baro_valid: bool; selftest: bool) returns (health: Health; usable: bool);
let
  guarantee "SRC_5_usable" usable = (baro_valid and selftest);
  guarantee "SRC_5_fault" health = SrcFault => not baro_valid;
  guarantee "SRC_5_ok" usable => health = SrcOk;
tel

contract KalmanChan_contract(freeze: bool; bootstrap: bool; meas_ok: bool; z: real; step: real; q: real; r: real) returns (pos: real; p: real; k: real);
let
  var preg: real = if freeze then 0.0 -> pre pos else (0.0 -> pre pos) + step;
  var prpg: real = 0.0 -> pre p;
  var rcg: real = if r < R_MIN then R_MIN else if r > P_CEIL then P_CEIL else r;
  var ppg: real = if freeze then 0.0 -> pre p else if bootstrap then P_CEIL else if (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q) < P_FLOOR then P_FLOOR else if (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q) > P_CEIL then P_CEIL else (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q);
  assume "step_bounded" step >= - VEL_STEP_MAX_M and step <= VEL_STEP_MAX_M;
  guarantee "KAL_1_gain" k >= 0.0 and k <= 1.0;
  guarantee "KAL_1_variance" p >= 0.0 and p <= P_CEIL and ppg >= 0.0 and ppg <= P_CEIL;
  guarantee "KAL_2_convex" not freeze and meas_ok and z >= - POS_SAT_M and z <= POS_SAT_M and preg >= - POS_SAT_M and preg <= POS_SAT_M => (preg <= z => pos >= preg and pos <= z) and (z < preg => pos >= z and pos <= preg);
  guarantee "KAL_3_update_variance" not freeze and meas_ok => p <= ppg and p >= 0.0;
  guarantee "KAL_3_predict_variance" not freeze and not meas_ok => p = ppg;
  guarantee "KAL_4_freeze" freeze => pos = (0.0 -> pre pos) and p = (0.0 -> pre p);
  guarantee "KAL_4_snap" not freeze and bootstrap => k >= 0.5 and k <= 1.0;
  guarantee "KAL_5_step" not freeze and not meas_ok => pos - (0.0 -> pre pos) <= VEL_STEP_MAX_M and (0.0 -> pre pos) - pos <= VEL_STEP_MAX_M;
  guarantee "KAL_6_range" pos >= - POS_SAT_M and pos <= POS_SAT_M;
tel

contract ClockDiscipline_contract(sync_en: bool; gnss_tow_s: int) returns (tow: int; synced: bool; holdover_s: int);
let
  assume "tow_in_week" gnss_tow_s >= 0 and gnss_tow_s <= TOW_MAX_S;
  guarantee "TME_1_synced" synced => tow = gnss_tow_s;
  guarantee "TME_1_resync" synced => holdover_s = 0;
  guarantee "TME_2_holdover" holdover_s >= 0 and holdover_s <= HOLDOVER_MAX_S;
  guarantee "TME_3_range" tow >= 0 and tow <= TOW_MAX_S;
tel

contract PNT_contract(gnss_valid: bool; fix: FixType; sats: int; hdop: int; gnss_x: real; gnss_y: real; gnss_z: real; gnss_time_valid: bool; gnss_tow_s: int; imu_valid: bool; imu_selftest: bool; dvx: real; dvy: real; dvz: real; baro_valid: bool; baro_selftest: bool; baro_alt: real) returns (sol_x: real; sol_y: real; sol_alt: real; sol_vx: real; sol_vy: real; sol_va: real; sol_tow: int; sol_status: PvtStatus; time_synced: bool; holdover_s: int; coast_cyc: int; protection_m: real; integrity_ok: bool; alert: Alert; gnss_usable: bool; imu_usable: bool; baro_usable: bool; innov_ok: bool; v_agree: bool; anchored: bool; kx: real; ky: real; ka: real; p_x: real; p_y: real; p_a: real; svx: real; svy: real; svz: real; gnss_health: Health; imu_health: Health; baro_health: Health);
let
  var pred_xg: real = 0.0 -> pre sol_x;
  var pred_yg: real = 0.0 -> pre sol_y;
  var pred_ag: real = 0.0 -> pre sol_alt;
  var prxg: real = (0.0 -> pre sol_x) + svx;
  var pryg: real = (0.0 -> pre sol_y) + svy;
  var prag: real = (0.0 -> pre sol_alt) + svz;
  var vxp: real = 0.0 -> pre sol_vx;
  var vyp: real = 0.0 -> pre sol_vy;
  var vap: real = 0.0 -> pre sol_va;
  assume "env_position" gnss_x >= - POS_MAX_M and gnss_x <= POS_MAX_M and gnss_y >= - POS_MAX_M and gnss_y <= POS_MAX_M and gnss_z >= - POS_MAX_M and gnss_z <= POS_MAX_M and baro_alt >= - POS_MAX_M and baro_alt <= POS_MAX_M;
  assume "env_time" gnss_tow_s >= 0 and gnss_tow_s <= TOW_MAX_S;
