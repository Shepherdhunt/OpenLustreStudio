  mode NoFixTime (
    require imu_valid and imu_selftest;
    require not (gnss_valid and fix = Fix3D and sats >= SATS_MIN and hdop <= HDOP_MAX and gnss_time_valid);
    ensure not time_synced;
    ensure holdover_s <= HOLDOVER_MAX_S;
  );
  mode ImuDown (
    require not (imu_valid and imu_selftest);
