-- package: user (constants)
const VEL_STEP_MAX_M : real = 2.0;
const POS_SAT_M : real = 12000.0;
const P_FLOOR : real = 0.25;
const P_CEIL : real = 100.0;
const R_MIN : real = 1.0;

contract BoundedF_contract(x: real; lo: real; hi: real) returns (y: real);
let
  guarantee "SRC_6_range" y >= lo and y <= hi;
  guarantee "SRC_6_identity" x >= lo and x <= hi => y = x;
tel

contract KalmanChan_contract(freeze: bool; bootstrap: bool; meas_ok: bool; z: real; step: real; q: real; r: real) returns (pos: real; p: real; k: real);
let
  var preg: real = if freeze then 0.0 -> pre pos else (0.0 -> pre pos) + step;
  var prpg: real = 0.0 -> pre p;
  var rcg: real = if r < R_MIN then R_MIN else if r > P_CEIL then P_CEIL else r;
  var ppg: real = if freeze then 0.0 -> pre p else if bootstrap then P_CEIL else if (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q) < P_FLOOR then P_FLOOR else if (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q) > P_CEIL then P_CEIL else (P_CEIL -> pre p) + (if q < 0.0 then 0.0 else if q > P_CEIL then P_CEIL else q);
  assume "step_bounded" step >= - VEL_STEP_MAX_M and step <= VEL_STEP_MAX_M;
  guarantee "KAL_1_gain" k >= 0.0 and k <= 1.0;
  guarantee "KAL_1_variance" p >= 0.0 and p <= P_CEIL and ppg >= 0.0 and ppg <= P_CEIL;
  guarantee "KAL_2_convex" not freeze and meas_ok and z >= - POS_SAT_M and z <= POS_SAT_M and preg >= - POS_SAT_M and preg <= POS_SAT_M => (preg <= z => pos >= preg and pos <= z) and (z < preg => pos >= z and pos <= preg);
  guarantee "KAL_3_update_variance" not freeze and meas_ok => p <= ppg and p >= 0.0;
  guarantee "KAL_3_predict_variance" not freeze and not meas_ok => p = ppg;
  guarantee "KAL_4_freeze" freeze => pos = (0.0 -> pre pos) and p = (0.0 -> pre p);
  guarantee "KAL_4_snap" not freeze and bootstrap => k >= 0.5 and k <= 1.0;
  guarantee "KAL_5_step" not freeze and not meas_ok => pos - (0.0 -> pre pos) <= VEL_STEP_MAX_M and (0.0 -> pre pos) - pos <= VEL_STEP_MAX_M;
  guarantee "KAL_6_range" pos >= - POS_SAT_M and pos <= POS_SAT_M;
tel

function BoundedF(x: real; lo: real; hi: real) returns (y: real);
(*@contract import BoundedF_contract(x, lo, hi) returns (y); *)
let
  y = if x < lo then lo else if x > hi then hi else x;
tel

node KalmanChan(freeze: bool; bootstrap: bool; meas_ok: bool; z: real; step: real; q: real; r: real) returns (pos: real; p: real; k: real);
(*@contract import KalmanChan_contract(freeze, bootstrap, meas_ok, z, step, q, r) returns (pos, p, k); *)
var pr: real; pp: real; qc: real; rc: real; __rtc0: real; __rtc1: real;
let
  --%MAIN;
  qc = BoundedF(q, 0.0, P_CEIL);
  rc = BoundedF(r, R_MIN, P_CEIL);
  pr = if freeze then 0.0 -> pre pos else (0.0 -> pre pos) + step;
  pp = if freeze then 0.0 -> pre p else if bootstrap then P_CEIL else __rtc0;
  k = pp / (pp + rc);
  pos = if freeze then pr else __rtc1;
  p = if freeze then pp else if meas_ok then (1.0 - k) * pp else pp;
  __rtc0 = BoundedF((P_CEIL -> pre p) + qc, P_FLOOR, P_CEIL);
  __rtc1 = BoundedF(if meas_ok then pr + k * (z - pr) else pr, - POS_SAT_M, POS_SAT_M);
tel

