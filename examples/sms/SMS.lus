-- package: user (types)
type StoreKind = enum { Empty, MedKit, SensorPod, WaterPack, SupplyCrate, Unknown };
type StationStatus = enum { Vacant, Loaded, Mismatch, Hung };
type SeqPhase = enum { PhSafe, PhReady, PhFiring, PhJettison, PhVerify };
type Inhibit = enum { Clear, NotArmed, OnGround, StationFault, LowAltitude, NoMatchingStore, WouldUnbalance };
type Sequencer_StateEnum = enum { Safe, Ready, Firing, Jettison, Verify };

-- package: user (constants)
const ARM_X : int = 150;
const ARM_Y : int = 200;
const MASS_MEDKIT : int = 1200;
const MASS_SENSORPOD : int = 800;
const MASS_WATERPACK : int = 1500;
const MASS_SUPPLYCRATE : int = 2000;
const ROLL_LIMIT : int = 250000;
const PITCH_LIMIT : int = 400000;
const MIN_RELEASE_ALT : int = 15;
const PULSE_CYCLES : int = 3;
const VERIFY_CYCLES : int = 5;

contract StationDecode_contract(present: bool; id: int; hung: bool) returns (kind: StoreKind; mass: int; status: StationStatus);
let
  guarantee "INV_1_catalogue" (id = 0 => kind = Empty) and (id = 1 => kind = MedKit) and (id = 2 => kind = SensorPod) and (id = 3 => kind = WaterPack) and (id = 4 => kind = SupplyCrate) and (id < 0 or id > 4 => kind = Unknown);
  guarantee "INV_2_loaded" status = Loaded => present and not hung and kind <> Empty and kind <> Unknown;
  guarantee "INV_2_vacant" status = Vacant => not present and kind = Empty;
  guarantee "INV_2_hung" hung => status = Hung;
  guarantee "INV_3_mass" (not present => mass = 0) and (status = Loaded => mass >= MASS_SENSORPOD and mass <= MASS_SUPPLYCRATE) and mass >= 0 and mass <= MASS_SUPPLYCRATE;
tel

contract Abs_contract(x: int) returns (y: int);
let
  guarantee "nonnegative" y >= 0;
  guarantee "magnitude" y = x or y = - x;
tel

contract Balance_contract(m1: int; m2: int; m3: int; m4: int) returns (total: int; roll: int; pitch: int; balanced: bool);
let
  assume "masses_in_catalogue_range" m1 >= 0 and m1 <= MASS_SUPPLYCRATE and m2 >= 0 and m2 <= MASS_SUPPLYCRATE and m3 >= 0 and m3 <= MASS_SUPPLYCRATE and m4 >= 0 and m4 <= MASS_SUPPLYCRATE;
  guarantee "INV_4_total" total = m1 + m2 + m3 + m4 and total >= 0 and total <= 4 * MASS_SUPPLYCRATE;
  guarantee "INV_4_symmetric" m1 = m2 and m3 = m4 => roll = 0;
  guarantee "BAL_1_limits" balanced = (roll <= ROLL_LIMIT and - roll <= ROLL_LIMIT and pitch <= PITCH_LIMIT and - pitch <= PITCH_LIMIT);
tel

contract Candidate_contract(eligible: bool; droll: int; dpitch: int; roll: int; pitch: int) returns (ok: bool; score: int);
let
  guarantee "only_eligible" ok => eligible;
  guarantee "keeps_limits" ok => roll - droll <= ROLL_LIMIT and - (roll - droll) <= ROLL_LIMIT and pitch - dpitch <= PITCH_LIMIT and - (pitch - dpitch) <= PITCH_LIMIT;
  guarantee "score_nonnegative" score >= 0;
tel

contract Best_contract(oka: bool; sca: int; ia: int; okb: bool; scb: int; ib: int) returns (ok: bool; sc: int; i: int);
let
  guarantee "feasible_if_either" ok = (oka or okb);
  guarantee "picks_a_feasible_one" (ok and i = ia => oka) and (ok and i <> ia => okb and i = ib);
  guarantee "none_is_zero" not ok => i = 0;
tel

contract PlanRelease_contract(req: StoreKind; k1: StoreKind; k2: StoreKind; k3: StoreKind; k4: StoreKind; l1: bool; l2: bool; l3: bool; l4: bool; m1: int; m2: int; m3: int; m4: int; roll: int; pitch: int) returns (s1: bool; s2: bool; s3: bool; s4: bool; found: bool; have_kind: bool);
let
  var dr: int = ARM_Y * ((if s2 then m2 else 0) + (if s4 then m4 else 0) - (if s1 then m1 else 0) - (if s3 then m3 else 0));
  var dp: int = ARM_X * ((if s1 then m1 else 0) + (if s2 then m2 else 0) - (if s3 then m3 else 0) - (if s4 then m4 else 0));
  var fits1: bool = l1 and k1 = req and roll - - ARM_Y * m1 <= ROLL_LIMIT and - (roll - - ARM_Y * m1) <= ROLL_LIMIT and pitch - ARM_X * m1 <= PITCH_LIMIT and - (pitch - ARM_X * m1) <= PITCH_LIMIT;
  var fits2: bool = l2 and k2 = req and roll - ARM_Y * m2 <= ROLL_LIMIT and - (roll - ARM_Y * m2) <= ROLL_LIMIT and pitch - ARM_X * m2 <= PITCH_LIMIT and - (pitch - ARM_X * m2) <= PITCH_LIMIT;
  var fits3: bool = l3 and k3 = req and roll - - ARM_Y * m3 <= ROLL_LIMIT and - (roll - - ARM_Y * m3) <= ROLL_LIMIT and pitch - - ARM_X * m3 <= PITCH_LIMIT and - (pitch - - ARM_X * m3) <= PITCH_LIMIT;
  var fits4: bool = l4 and k4 = req and roll - ARM_Y * m4 <= ROLL_LIMIT and - (roll - ARM_Y * m4) <= ROLL_LIMIT and pitch - - ARM_X * m4 <= PITCH_LIMIT and - (pitch - - ARM_X * m4) <= PITCH_LIMIT;
  assume "masses_in_catalogue_range" m1 >= 0 and m1 <= MASS_SUPPLYCRATE and m2 >= 0 and m2 <= MASS_SUPPLYCRATE and m3 >= 0 and m3 <= MASS_SUPPLYCRATE and m4 >= 0 and m4 <= MASS_SUPPLYCRATE;
  guarantee "BAL_2_stays_balanced" found => roll - dr <= ROLL_LIMIT and - (roll - dr) <= ROLL_LIMIT and pitch - dp <= PITCH_LIMIT and - (pitch - dp) <= PITCH_LIMIT;
  guarantee "BAL_5_complete" fits1 or fits2 or fits3 or fits4 => found;
  guarantee "BAL_6_requested_only" (s1 => l1 and k1 = req) and (s2 => l2 and k2 = req) and (s3 => l3 and k3 = req) and (s4 => l4 and k4 = req);
  guarantee "BAL_6_lateral" not ((s1 or s2) and (s3 or s4));
  guarantee "found_iff_selected" found = (s1 or s2 or s3 or s4);
  guarantee "have_kind_def" have_kind = (l1 and k1 = req or l2 and k2 = req or l3 and k3 = req or l4 and k4 = req);
tel

contract ReleaseSequencer_contract(ready_ok: bool; fire_req: bool; jettison_req: bool; alt_ok: bool; sel1: bool; sel2: bool; sel3: bool; sel4: bool; present1: bool; present2: bool; present3: bool; present4: bool; maint_reset: bool; on_ground: bool) returns (fire1: bool; fire2: bool; fire3: bool; fire4: bool; phase: SeqPhase; hung1: bool; hung2: bool; hung3: bool; hung4: bool);
let
  guarantee "REL_1_ready" fire1 or fire2 or fire3 or fire4 => ready_ok;
  guarantee "REL_2_altitude" (fire1 or fire2 or fire3 or fire4) and phase <> PhJettison => alt_ok;
  guarantee "REL_9_fires_only_when_releasing" fire1 or fire2 or fire3 or fire4 => phase = PhFiring or phase = PhJettison;
tel

contract SMS_contract(master_arm: bool; wow: bool; alt_m: int; release_req: bool; req_kind: StoreKind; jettison_req: bool; maint_reset: bool; present1: bool; id1: int; present2: bool; id2: int; present3: bool; id3: int; present4: bool; id4: int) returns (kind1: StoreKind; kind2: StoreKind; kind3: StoreKind; kind4: StoreKind; status1: StationStatus; status2: StationStatus; status3: StationStatus; status4: StationStatus; total_mass: int; roll: int; pitch: int; balanced: bool; next1: bool; next2: bool; next3: bool; next4: bool; fire1: bool; fire2: bool; fire3: bool; fire4: bool; phase: SeqPhase; inhibit: Inhibit);
let
  var fire_any: bool = fire1 or fire2 or fire3 or fire4;
  var run1: int = if fire1 then 1 -> pre run1 + 1 else 0;
  var run2: int = if fire2 then 1 -> pre run2 + 1 else 0;
  var run3: int = if fire3 then 1 -> pre run3 + 1 else 0;
  var run4: int = if fire4 then 1 -> pre run4 + 1 else 0;
  guarantee "REL_1_armed_airborne" fire_any => master_arm and not wow;
  guarantee "REL_2_min_altitude" fire_any and phase <> PhJettison => alt_m >= MIN_RELEASE_ALT;
  guarantee "REL_3_lateral_pairs" phase <> PhJettison => not ((fire1 or fire2) and (fire3 or fire4));
  guarantee "REL_4_pulse_bounded" run1 <= PULSE_CYCLES and run2 <= PULSE_CYCLES and run3 <= PULSE_CYCLES and run4 <= PULSE_CYCLES;
  guarantee "REL_5_no_refire_hung" phase <> PhJettison => not (fire1 and status1 = Hung) and not (fire2 and status2 = Hung) and not (fire3 and status3 = Hung) and not (fire4 and status4 = Hung);
  guarantee "REL_6_clear_means_safe" inhibit = Clear => master_arm and not wow and alt_m >= MIN_RELEASE_ALT;
  guarantee "BAL_6_next_is_loaded_request" (next1 => status1 = Loaded and kind1 = req_kind) and (next2 => status2 = Loaded and kind2 = req_kind) and (next3 => status3 = Loaded and kind3 = req_kind) and (next4 => status4 = Loaded and kind4 = req_kind);
  guarantee "BAL_6_next_lateral" not ((next1 or next2) and (next3 or next4));
  guarantee "BAL_1_reported" balanced = (roll <= ROLL_LIMIT and - roll <= ROLL_LIMIT and pitch <= PITCH_LIMIT and - pitch <= PITCH_LIMIT);
  mode Grounded (
    require wow;
    ensure not fire_any;
    ensure inhibit = NotArmed or inhibit = OnGround;
  );
  mode Disarmed (
    require not wow;
    require not master_arm;
    ensure not fire_any;
    ensure inhibit = NotArmed;
  );
  mode ArmedAirborne (
    require not wow;
    require master_arm;
    ensure inhibit <> NotArmed and inhibit <> OnGround;
  );
tel

function StationDecode(present: bool; id: int; hung: bool) returns (kind: StoreKind; mass: int; status: StationStatus);
(*@contract import StationDecode_contract(present, id, hung) returns (kind, mass, status); *)
let
  kind = if id = 0 then Empty else if id = 1 then MedKit else if id = 2 then SensorPod else if id = 3 then WaterPack else if id = 4 then SupplyCrate else Unknown;
  status = if hung then Hung else if present and kind <> Empty and kind <> Unknown then Loaded else if not present and kind = Empty then Vacant else Mismatch;
  mass = if not present then 0 else if kind = MedKit then MASS_MEDKIT else if kind = SensorPod then MASS_SENSORPOD else if kind = WaterPack then MASS_WATERPACK else if kind = SupplyCrate then MASS_SUPPLYCRATE else 0;
tel

function Abs(x: int) returns (y: int);
(*@contract import Abs_contract(x) returns (y); *)
let
  y = if x < 0 then - x else x;
tel

function Balance(m1: int; m2: int; m3: int; m4: int) returns (total: int; roll: int; pitch: int; balanced: bool);
(*@contract import Balance_contract(m1, m2, m3, m4) returns (total, roll, pitch, balanced); *)
let
  total = m1 + m2 + m3 + m4;
  roll = ARM_Y * (m2 + m4 - m1 - m3);
  pitch = ARM_X * (m1 + m2 - m3 - m4);
  balanced = Abs(roll) <= ROLL_LIMIT and Abs(pitch) <= PITCH_LIMIT;
tel

function Candidate(eligible: bool; droll: int; dpitch: int; roll: int; pitch: int) returns (ok: bool; score: int);
(*@contract import Candidate_contract(eligible, droll, dpitch, roll, pitch) returns (ok, score); *)
var r: int; p: int;
let
  r = Abs(roll - droll);
  p = Abs(pitch - dpitch);
  ok = eligible and r <= ROLL_LIMIT and p <= PITCH_LIMIT;
  score = r + p;
tel

function Best(oka: bool; sca: int; ia: int; okb: bool; scb: int; ib: int) returns (ok: bool; sc: int; i: int);
(*@contract import Best_contract(oka, sca, ia, okb, scb, ib) returns (ok, sc, i); *)
var take_a: bool;
let
  take_a = oka and (not okb or sca <= scb);
  ok = oka or okb;
  sc = if take_a then sca else scb;
  i = if take_a then ia else if okb then ib else 0;
tel

function PlanRelease(req: StoreKind; k1: StoreKind; k2: StoreKind; k3: StoreKind; k4: StoreKind; l1: bool; l2: bool; l3: bool; l4: bool; m1: int; m2: int; m3: int; m4: int; roll: int; pitch: int) returns (s1: bool; s2: bool; s3: bool; s4: bool; found: bool; have_kind: bool);
(*@contract import PlanRelease_contract(req, k1, k2, k3, k4, l1, l2, l3, l4, m1, m2, m3, m4, roll, pitch) returns (s1, s2, s3, s4, found, have_kind); *)
var e1: bool; e2: bool; e3: bool; e4: bool; ok1: bool; ok2: bool; ok3: bool; ok4: bool; sc1: int; sc2: int; sc3: int; sc4: int; ok12: bool; sc12: int; i12: int; ok34: bool; sc34: int; i34: int; single: bool; scs: int; best: int; front: bool; scf: int; rear: bool; scr: int;
let
  e1 = l1 and k1 = req;
  e2 = l2 and k2 = req;
  e3 = l3 and k3 = req;
  e4 = l4 and k4 = req;
  have_kind = e1 or e2 or e3 or e4;
  (ok1, sc1) = Candidate(e1, - ARM_Y * m1, ARM_X * m1, roll, pitch);
  (ok2, sc2) = Candidate(e2, ARM_Y * m2, ARM_X * m2, roll, pitch);
  (ok3, sc3) = Candidate(e3, - ARM_Y * m3, - ARM_X * m3, roll, pitch);
  (ok4, sc4) = Candidate(e4, ARM_Y * m4, - ARM_X * m4, roll, pitch);
  (ok12, sc12, i12) = Best(ok1, sc1, 1, ok2, sc2, 2);
  (ok34, sc34, i34) = Best(ok3, sc3, 3, ok4, sc4, 4);
  (single, scs, best) = Best(ok12, sc12, i12, ok34, sc34, i34);
  (front, scf) = Candidate(e1 and e2, ARM_Y * (m2 - m1), ARM_X * (m1 + m2), roll, pitch);
  (rear, scr) = Candidate(e3 and e4, ARM_Y * (m4 - m3), - ARM_X * (m3 + m4), roll, pitch);
  found = single or front or rear;
  s1 = if single then best = 1 else front;
  s2 = if single then best = 2 else front;
  s3 = if single then best = 3 else not front and rear;
  s4 = if single then best = 4 else not front and rear;
tel

node ReleaseSequencer(ready_ok: bool; fire_req: bool; jettison_req: bool; alt_ok: bool; sel1: bool; sel2: bool; sel3: bool; sel4: bool; present1: bool; present2: bool; present3: bool; present4: bool; maint_reset: bool; on_ground: bool) returns (fire1: bool; fire2: bool; fire3: bool; fire4: bool; phase: SeqPhase; hung1: bool; hung2: bool; hung3: bool; hung4: bool);
(*@contract import ReleaseSequencer_contract(ready_ok, fire_req, jettison_req, alt_ok, sel1, sel2, sel3, sel4, present1, present2, present3, present4, maint_reset, on_ground) returns (fire1, fire2, fire3, fire4, phase, hung1, hung2, hung3, hung4); *)
var pulse: bool; jett: bool; cnt: int; start: bool; start_j: bool; lat1: bool; lat2: bool; lat3: bool; lat4: bool; settled1: bool; settled2: bool; settled3: bool; settled4: bool; clear: bool; timeout: bool; reset: bool; permit: bool; __sm_state: Sequencer_StateEnum; __sm_next_state: Sequencer_StateEnum;
let
  cnt = 0 -> (if phase <> pre phase then 0 else pre cnt + 1);
  start = phase = PhReady and fire_req;
  start_j = phase = PhReady and jettison_req;
  lat1 = false -> (if start_j then present1 else if start then sel1 else pre lat1);
  lat2 = false -> (if start_j then present2 else if start then sel2 else pre lat2);
  lat3 = false -> (if start_j then present3 else if start then sel3 else pre lat3);
  lat4 = false -> (if start_j then present4 else if start then sel4 else pre lat4);
  settled1 = not (lat1 and present1);
  settled2 = not (lat2 and present2);
  settled3 = not (lat3 and present3);
  settled4 = not (lat4 and present4);
  clear = settled1 and settled2 and settled3 and settled4;
  timeout = phase = PhVerify and cnt >= VERIFY_CYCLES - 1;
  reset = maint_reset and on_ground;
  hung1 = false -> (if reset then false else pre hung1 or timeout and lat1 and present1);
  hung2 = false -> (if reset then false else pre hung2 or timeout and lat2 and present2);
  hung3 = false -> (if reset then false else pre hung3 or timeout and lat3 and present3);
  hung4 = false -> (if reset then false else pre hung4 or timeout and lat4 and present4);
  permit = ready_ok and (jett or alt_ok);
  fire1 = pulse and lat1 and permit;
  fire2 = pulse and lat2 and permit;
  fire3 = pulse and lat3 and permit;
  fire4 = pulse and lat4 and permit;
  __sm_state = Safe -> pre __sm_next_state;
  __sm_next_state = if __sm_state = Safe then if ready_ok then Ready else __sm_state else if __sm_state = Ready then if not ready_ok then Safe else if jettison_req then Jettison else if fire_req then Firing else __sm_state else if __sm_state = Firing then if not ready_ok then Safe else if cnt >= PULSE_CYCLES - 1 then Verify else __sm_state else if __sm_state = Jettison then if not ready_ok then Safe else if cnt >= PULSE_CYCLES - 1 then Verify else __sm_state else if clear then Ready else if timeout then Ready else __sm_state;
  phase = if __sm_state = Safe then PhSafe else if __sm_state = Ready then PhReady else if __sm_state = Firing then PhFiring else if __sm_state = Jettison then PhJettison else PhVerify;
  pulse = if __sm_state = Safe then false else if __sm_state = Ready then false else if __sm_state = Firing then true else if __sm_state = Jettison then true else false;
  jett = if __sm_state = Safe then false else if __sm_state = Ready then false else if __sm_state = Firing then false else if __sm_state = Jettison then true else false;
tel

node SMS(master_arm: bool; wow: bool; alt_m: int; release_req: bool; req_kind: StoreKind; jettison_req: bool; maint_reset: bool; present1: bool; id1: int; present2: bool; id2: int; present3: bool; id3: int; present4: bool; id4: int) returns (kind1: StoreKind; kind2: StoreKind; kind3: StoreKind; kind4: StoreKind; status1: StationStatus; status2: StationStatus; status3: StationStatus; status4: StationStatus; total_mass: int; roll: int; pitch: int; balanced: bool; next1: bool; next2: bool; next3: bool; next4: bool; fire1: bool; fire2: bool; fire3: bool; fire4: bool; phase: SeqPhase; inhibit: Inhibit);
(*@contract import SMS_contract(master_arm, wow, alt_m, release_req, req_kind, jettison_req, maint_reset, present1, id1, present2, id2, present3, id3, present4, id4) returns (kind1, kind2, kind3, kind4, status1, status2, status3, status4, total_mass, roll, pitch, balanced, next1, next2, next3, next4, fire1, fire2, fire3, fire4, phase, inhibit); *)
var m1: int; m2: int; m3: int; m4: int; was_hung1: bool; was_hung2: bool; was_hung3: bool; was_hung4: bool; hung1: bool; hung2: bool; hung3: bool; hung4: bool; found: bool; have_kind: bool; ready_ok: bool; alt_ok: bool; fault_any: bool; rel_edge: bool; jet_edge: bool; fire_req: bool; __act_Inhibit_b1: bool; __act_Inhibit_n1: bool; __act_Inhibit_b2: bool; __act_Inhibit_n2: bool; __act_Inhibit_b3: bool; __act_Inhibit_n3: bool; __act_Inhibit_b4: bool; __act_Inhibit_n4: bool; __act_Inhibit_b5: bool; __act_Inhibit_n5: bool; __act_Inhibit_b6: bool; __act_Inhibit_g2: bool; __act_Inhibit_g3: bool; __act_Inhibit_g4: bool; __act_Inhibit_g5: bool; __act_Inhibit_g6: bool; __act_Inhibit_x1_inhibit: Inhibit; __act_Inhibit_x2_inhibit: Inhibit; __act_Inhibit_x3_inhibit: Inhibit; __act_Inhibit_x4_inhibit: Inhibit; __act_Inhibit_x5_inhibit: Inhibit; __act_Inhibit_x6_inhibit: Inhibit; __act_Inhibit_xe_inhibit: Inhibit; __ck5: bool; __ck0: bool; __ck6: bool; __ck1: bool; __ck7: bool; __ck2: bool; __ck8: bool; __ck3: bool; __ck9: bool; __ck4: bool; __ck10: bool; __ck11: bool;
let
  --%MAIN;
  __ck5 = __act_Inhibit_b1;
  __ck0 = not __act_Inhibit_b1;
  __ck6 = __ck0 and __act_Inhibit_g2;
  __ck1 = __ck0 and not __act_Inhibit_g2;
  __ck7 = __ck1 and __act_Inhibit_g3;
  __ck2 = __ck1 and not __act_Inhibit_g3;
  __ck8 = __ck2 and __act_Inhibit_g4;
  __ck3 = __ck2 and not __act_Inhibit_g4;
  __ck9 = __ck3 and __act_Inhibit_g5;
  __ck4 = __ck3 and not __act_Inhibit_g5;
  __ck10 = __ck4 and __act_Inhibit_g6;
  __ck11 = __ck4 and not __act_Inhibit_g6;
  was_hung1 = false -> pre hung1;
  was_hung2 = false -> pre hung2;
  was_hung3 = false -> pre hung3;
  was_hung4 = false -> pre hung4;
  (kind1, m1, status1) = StationDecode(present1, id1, was_hung1);
  (kind2, m2, status2) = StationDecode(present2, id2, was_hung2);
  (kind3, m3, status3) = StationDecode(present3, id3, was_hung3);
  (kind4, m4, status4) = StationDecode(present4, id4, was_hung4);
  (total_mass, roll, pitch, balanced) = Balance(m1, m2, m3, m4);
  (next1, next2, next3, next4, found, have_kind) = PlanRelease(req_kind, kind1, kind2, kind3, kind4, status1 = Loaded, status2 = Loaded, status3 = Loaded, status4 = Loaded, m1, m2, m3, m4, roll, pitch);
  ready_ok = master_arm and not wow;
  alt_ok = alt_m >= MIN_RELEASE_ALT;
  fault_any = status1 = Mismatch or status2 = Mismatch or status3 = Mismatch or status4 = Mismatch;
  rel_edge = release_req and not (false -> pre release_req);
  jet_edge = jettison_req and not (false -> pre jettison_req);
  fire_req = rel_edge and inhibit = Clear;
  (fire1, fire2, fire3, fire4, phase, hung1, hung2, hung3, hung4) = ReleaseSequencer(ready_ok, fire_req, jet_edge, alt_ok, next1, next2, next3, next4, present1, present2, present3, present4, maint_reset, wow);
  __act_Inhibit_b1 = not master_arm;
  __act_Inhibit_n1 = not not master_arm;
  __act_Inhibit_b2 = __act_Inhibit_n1 and wow;
  __act_Inhibit_n2 = __act_Inhibit_n1 and not wow;
  __act_Inhibit_b3 = __act_Inhibit_n2 and fault_any;
  __act_Inhibit_n3 = __act_Inhibit_n2 and not fault_any;
  __act_Inhibit_b4 = __act_Inhibit_n3 and not alt_ok;
  __act_Inhibit_n4 = __act_Inhibit_n3 and not not alt_ok;
  __act_Inhibit_b5 = __act_Inhibit_n4 and not have_kind;
  __act_Inhibit_n5 = __act_Inhibit_n4 and not not have_kind;
  __act_Inhibit_b6 = __act_Inhibit_n5 and not found;
  __act_Inhibit_g2 = if __ck0 then __act_Inhibit_b2 else false -> pre __act_Inhibit_g2;
  __act_Inhibit_g3 = if __ck1 then __act_Inhibit_b3 else false -> pre __act_Inhibit_g3;
  __act_Inhibit_g4 = if __ck2 then __act_Inhibit_b4 else false -> pre __act_Inhibit_g4;
  __act_Inhibit_g5 = if __ck3 then __act_Inhibit_b5 else false -> pre __act_Inhibit_g5;
  __act_Inhibit_g6 = if __ck4 then __act_Inhibit_b6 else false -> pre __act_Inhibit_g6;
  __act_Inhibit_x1_inhibit = if __ck5 then NotArmed else Clear -> pre __act_Inhibit_x1_inhibit;
  __act_Inhibit_x2_inhibit = if __ck6 then OnGround else Clear -> pre __act_Inhibit_x2_inhibit;
