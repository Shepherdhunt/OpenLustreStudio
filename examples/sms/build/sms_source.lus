-- SMS — Stores Management System (see ../PLAN.md).
-- The dataflow part of the model, imported into the Studio with
-- Import Lustre; build_sms.py then adds the Sequencer state machine, the
-- Inhibit activation and the contracts. Station geometry: 1 front-left,
-- 2 front-right, 3 rear-left, 4 rear-right; x forward, y right, mm.

type StoreKind = enum { Empty, MedKit, SensorPod, WaterPack, SupplyCrate, Unknown };
type StationStatus = enum { Vacant, Loaded, Mismatch, Hung };
type SeqPhase = enum { PhSafe, PhReady, PhFiring, PhJettison, PhVerify };
type Inhibit = enum { Clear, NotArmed, OnGround, StationFault, LowAltitude, NoMatchingStore, WouldUnbalance };

const ARM_X : int32 = 150;
const ARM_Y : int32 = 200;
const MASS_MEDKIT : int32 = 1200;
const MASS_SENSORPOD : int32 = 800;
const MASS_WATERPACK : int32 = 1500;
const MASS_SUPPLYCRATE : int32 = 2000;
const ROLL_LIMIT : int32 = 250000;
const PITCH_LIMIT : int32 = 400000;
const MIN_RELEASE_ALT : int32 = 15;
const PULSE_CYCLES : int32 = 3;
const VERIFY_CYCLES : int32 = 5;

-- INV-1..3: what hangs on one station.
function StationDecode(present: bool; id: int32; hung: bool)
returns (kind: StoreKind; mass: int32; status: StationStatus);
let
  kind = if id = 0 then Empty
         else if id = 1 then MedKit
         else if id = 2 then SensorPod
         else if id = 3 then WaterPack
         else if id = 4 then SupplyCrate
         else Unknown;
  status = if hung then Hung
           else if present and kind <> Empty and kind <> Unknown then Loaded
           else if not present and kind = Empty then Vacant
           else Mismatch;
  mass = if not present then 0
         else if kind = MedKit then MASS_MEDKIT
         else if kind = SensorPod then MASS_SENSORPOD
         else if kind = WaterPack then MASS_WATERPACK
         else if kind = SupplyCrate then MASS_SUPPLYCRATE
         else 0;
tel

function Abs(x: int32) returns (y: int32);
let
  y = if x < 0 then - x else x;
tel

-- INV-4, BAL-1: total mass and the moments about the centre of gravity.
function Balance(m1: int32; m2: int32; m3: int32; m4: int32)
returns (total: int32; roll: int32; pitch: int32; balanced: bool);
let
  total = m1 + m2 + m3 + m4;
  roll = ARM_Y * (m2 + m4 - m1 - m3);
  pitch = ARM_X * (m1 + m2 - m3 - m4);
  balanced = Abs(roll) <= ROLL_LIMIT and Abs(pitch) <= PITCH_LIMIT;
tel

-- Removing stores whose moments are (droll, dpitch): does the vehicle stay
-- balanced, and how much imbalance is left?
function Candidate(eligible: bool; droll: int32; dpitch: int32; roll: int32; pitch: int32)
returns (ok: bool; score: int32);
var r: int32; p: int32;
let
  r = Abs(roll - droll);
  p = Abs(pitch - dpitch);
  ok = eligible and r <= ROLL_LIMIT and p <= PITCH_LIMIT;
  score = r + p;
tel

-- The better of two candidates: feasible first, then the lower score,
-- then the first one.
function Best(oka: bool; sca: int32; ia: int32; okb: bool; scb: int32; ib: int32)
returns (ok: bool; sc: int32; i: int32);
var take_a: bool;
let
  take_a = oka and (not okb or sca <= scb);
  ok = oka or okb;
  sc = if take_a then sca else scb;
  i = if take_a then ia else if okb then ib else 0;
tel

-- BAL-2..6: which station(s) to release for the requested kind.
function PlanRelease(req: StoreKind;
                     k1: StoreKind; k2: StoreKind; k3: StoreKind; k4: StoreKind;
                     l1: bool; l2: bool; l3: bool; l4: bool;
                     m1: int32; m2: int32; m3: int32; m4: int32;
                     roll: int32; pitch: int32)
returns (s1: bool; s2: bool; s3: bool; s4: bool; found: bool; have_kind: bool);
var e1: bool; e2: bool; e3: bool; e4: bool;
    ok1: bool; ok2: bool; ok3: bool; ok4: bool;
    sc1: int32; sc2: int32; sc3: int32; sc4: int32;
    ok12: bool; sc12: int32; i12: int32;
    ok34: bool; sc34: int32; i34: int32;
    single: bool; scs: int32; best: int32;
    front: bool; scf: int32; rear: bool; scr: int32;
let
  e1 = l1 and k1 = req;
  e2 = l2 and k2 = req;
  e3 = l3 and k3 = req;
  e4 = l4 and k4 = req;
  have_kind = e1 or e2 or e3 or e4;
  (ok1, sc1) = Candidate(e1, - ARM_Y * m1, ARM_X * m1, roll, pitch);
  (ok2, sc2) = Candidate(e2, ARM_Y * m2, ARM_X * m2, roll, pitch);
  (ok3, sc3) = Candidate(e3, - ARM_Y * m3, - ARM_X * m3, roll, pitch);
  (ok4, sc4) = Candidate(e4, ARM_Y * m4, - ARM_X * m4, roll, pitch);
  (ok12, sc12, i12) = Best(ok1, sc1, 1, ok2, sc2, 2);
  (ok34, sc34, i34) = Best(ok3, sc3, 3, ok4, sc4, 4);
  (single, scs, best) = Best(ok12, sc12, i12, ok34, sc34, i34);
  (front, scf) = Candidate(e1 and e2, ARM_Y * (m2 - m1), ARM_X * (m1 + m2), roll, pitch);
  (rear, scr) = Candidate(e3 and e4, ARM_Y * (m4 - m3), - ARM_X * (m3 + m4), roll, pitch);
  found = single or front or rear;
  s1 = if single then best = 1 else front;
  s2 = if single then best = 2 else front;
  s3 = if single then best = 3 else not front and rear;
  s4 = if single then best = 4 else not front and rear;
tel

-- REL-1..5, 7..9: latch the plan, pulse the hooks, catch hung stores.
-- A hung station is never re-fired by a selective release because the
-- plan only selects Loaded stations (proved in SMS_contract, REL_5).
-- `phase`, `pulse` and `jett` are driven by the Sequencer state machine.
node ReleaseSequencer(ready_ok: bool; fire_req: bool; jettison_req: bool; alt_ok: bool;
                      sel1: bool; sel2: bool; sel3: bool; sel4: bool;
                      present1: bool; present2: bool; present3: bool; present4: bool;
                      maint_reset: bool; on_ground: bool)
returns (fire1: bool; fire2: bool; fire3: bool; fire4: bool; phase: SeqPhase;
         hung1: bool; hung2: bool; hung3: bool; hung4: bool);
var pulse: bool; jett: bool; cnt: int32; start: bool; start_j: bool;
    lat1: bool; lat2: bool; lat3: bool; lat4: bool;
    settled1: bool; settled2: bool; settled3: bool; settled4: bool;
    clear: bool; timeout: bool; reset: bool; permit: bool;
let
  -- Cycles in the current phase, saturating (RTE-1): every use compares it
  -- with a smaller bound, and a counter left to run would overflow int32.
  cnt = 0 -> if phase <> pre phase then 0
             else if pre cnt < PULSE_CYCLES + VERIFY_CYCLES then pre cnt + 1 else pre cnt;
  start = phase = PhReady and fire_req;
  start_j = phase = PhReady and jettison_req;
  lat1 = false -> if start_j then present1 else if start then sel1 else pre lat1;
  lat2 = false -> if start_j then present2 else if start then sel2 else pre lat2;
  lat3 = false -> if start_j then present3 else if start then sel3 else pre lat3;
  lat4 = false -> if start_j then present4 else if start then sel4 else pre lat4;
  -- A station is settled once no released store still hangs on it.
  settled1 = not (lat1 and present1);
  settled2 = not (lat2 and present2);
  settled3 = not (lat3 and present3);
  settled4 = not (lat4 and present4);
  clear = settled1 and settled2 and settled3 and settled4;
  timeout = phase = PhVerify and cnt >= VERIFY_CYCLES - 1;
  reset = maint_reset and on_ground;
  hung1 = false -> if reset then false else pre hung1 or timeout and lat1 and present1;
  hung2 = false -> if reset then false else pre hung2 or timeout and lat2 and present2;
  hung3 = false -> if reset then false else pre hung3 or timeout and lat3 and present3;
  hung4 = false -> if reset then false else pre hung4 or timeout and lat4 and present4;
  -- Checked every cycle of a pulse: arming, airborne, and (for a
  -- selective release) the altitude floor.
  permit = ready_ok and (jett or alt_ok);
  fire1 = pulse and lat1 and permit;
  fire2 = pulse and lat2 and permit;
  fire3 = pulse and lat3 and permit;
  fire4 = pulse and lat4 and permit;
tel

-- The Stores Management System. `inhibit` is driven by the Inhibit
-- activation.
node SMS(master_arm: bool; wow: bool; alt_m: int32;
         release_req: bool; req_kind: StoreKind; jettison_req: bool; maint_reset: bool;
         present1: bool; id1: int32; present2: bool; id2: int32;
         present3: bool; id3: int32; present4: bool; id4: int32)
returns (kind1: StoreKind; kind2: StoreKind; kind3: StoreKind; kind4: StoreKind;
         status1: StationStatus; status2: StationStatus; status3: StationStatus; status4: StationStatus;
         total_mass: int32; roll: int32; pitch: int32; balanced: bool;
         next1: bool; next2: bool; next3: bool; next4: bool;
         fire1: bool; fire2: bool; fire3: bool; fire4: bool;
         phase: SeqPhase; inhibit: Inhibit);
var m1: int32; m2: int32; m3: int32; m4: int32;
    was_hung1: bool; was_hung2: bool; was_hung3: bool; was_hung4: bool;
    hung1: bool; hung2: bool; hung3: bool; hung4: bool;
    found: bool; have_kind: bool;
    ready_ok: bool; alt_ok: bool; fault_any: bool;
    rel_edge: bool; jet_edge: bool; fire_req: bool;
let
  was_hung1 = false -> pre hung1;
  was_hung2 = false -> pre hung2;
  was_hung3 = false -> pre hung3;
  was_hung4 = false -> pre hung4;
  (kind1, m1, status1) = StationDecode(present1, id1, was_hung1);
  (kind2, m2, status2) = StationDecode(present2, id2, was_hung2);
  (kind3, m3, status3) = StationDecode(present3, id3, was_hung3);
  (kind4, m4, status4) = StationDecode(present4, id4, was_hung4);
  (total_mass, roll, pitch, balanced) = Balance(m1, m2, m3, m4);
  -- next_k: the hooks the next release of req_kind would open.
  (next1, next2, next3, next4, found, have_kind) = PlanRelease(req_kind, kind1, kind2, kind3, kind4,
      status1 = Loaded, status2 = Loaded, status3 = Loaded, status4 = Loaded,
      m1, m2, m3, m4, roll, pitch);
  ready_ok = master_arm and not wow;
  alt_ok = alt_m >= MIN_RELEASE_ALT;
  fault_any = status1 = Mismatch or status2 = Mismatch or status3 = Mismatch or status4 = Mismatch;
  rel_edge = release_req and not (false -> pre release_req);
  jet_edge = jettison_req and not (false -> pre jettison_req);
  fire_req = rel_edge and inhibit = Clear;
  (fire1, fire2, fire3, fire4, phase, hung1, hung2, hung3, hung4) = ReleaseSequencer(
      ready_ok, fire_req, jet_edge, alt_ok, next1, next2, next3, next4,
      present1, present2, present3, present4, maint_reset, wow);
tel
