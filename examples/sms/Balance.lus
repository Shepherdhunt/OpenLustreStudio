-- Generated by OpenLustre Studio for Kind 2.
-- project: SMS
-- note: integers are proved as mathematical integers — the result holds for the generated C as long as no arithmetic overflows (integer division and casts follow C)

-- package: user (constants)
const ARM_X : int = 150;
const ARM_Y : int = 200;
const MASS_SUPPLYCRATE : int = 2000;
const ROLL_LIMIT : int = 250000;
const PITCH_LIMIT : int = 400000;

contract Abs_contract(x: int) returns (y: int);
let
  guarantee "nonnegative" y >= 0;
  guarantee "magnitude" y = x or y = - x;
tel

contract Balance_contract(m1: int; m2: int; m3: int; m4: int) returns (total: int; roll: int; pitch: int; balanced: bool);
let
  assume "masses_in_catalogue_range" m1 >= 0 and m1 <= MASS_SUPPLYCRATE and m2 >= 0 and m2 <= MASS_SUPPLYCRATE and m3 >= 0 and m3 <= MASS_SUPPLYCRATE and m4 >= 0 and m4 <= MASS_SUPPLYCRATE;
  guarantee "INV_4_total" total = m1 + m2 + m3 + m4 and total >= 0 and total <= 4 * MASS_SUPPLYCRATE;
  guarantee "INV_4_symmetric" m1 = m2 and m3 = m4 => roll = 0;
  guarantee "BAL_1_limits" balanced = (roll <= ROLL_LIMIT and - roll <= ROLL_LIMIT and pitch <= PITCH_LIMIT and - pitch <= PITCH_LIMIT);
tel

function Abs(x: int) returns (y: int);
(*@contract import Abs_contract(x) returns (y); *)
let
  y = if x < 0 then - x else x;
tel

function Balance(m1: int; m2: int; m3: int; m4: int) returns (total: int; roll: int; pitch: int; balanced: bool);
(*@contract import Balance_contract(m1, m2, m3, m4) returns (total, roll, pitch, balanced); *)
let
  --%MAIN;
  total = m1 + m2 + m3 + m4;
  roll = ARM_Y * (m2 + m4 - m1 - m3);
  pitch = ARM_X * (m1 + m2 - m3 - m4);
  balanced = Abs(roll) <= ROLL_LIMIT and Abs(pitch) <= PITCH_LIMIT;
tel

