  __rte3 = - 2147483648 <= ARM_Y * (m2 + m4 - m1 - m3) and ARM_Y * (m2 + m4 - m1 - m3) <= 2147483647;
  __rte4 = - 2147483648 <= m2 + m4 - m1 - m3 and m2 + m4 - m1 - m3 <= 2147483647;
  __rte5 = - 2147483648 <= m2 + m4 - m1 and m2 + m4 - m1 <= 2147483647;
  __rte6 = - 2147483648 <= m2 + m4 and m2 + m4 <= 2147483647;
  __rte7 = - 2147483648 <= ARM_X * (m1 + m2 - m3 - m4) and ARM_X * (m1 + m2 - m3 - m4) <= 2147483647;
  __rte8 = - 2147483648 <= m1 + m2 - m3 - m4 and m1 + m2 - m3 - m4 <= 2147483647;
  __rte9 = - 2147483648 <= m1 + m2 - m3 and m1 + m2 - m3 <= 2147483647;
  __rte10 = - 2147483648 <= m1 + m2 and m1 + m2 <= 2147483647;
  --%PROPERTY "rte1" __rte0;
