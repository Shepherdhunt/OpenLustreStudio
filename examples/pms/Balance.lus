let
  --%MAIN;
  total = m1 + m2 + m3 + m4;
  roll = ARM_Y * (m2 + m4 - m1 - m3);
  pitch = ARM_X * (m1 + m2 - m3 - m4);
  balanced = __rtc0 <= ROLL_LIMIT and __rtc1 <= PITCH_LIMIT;
  (__rtc0, __rtp0) = Abs(roll);
  (__rtc1, __rtp1) = Abs(pitch);
